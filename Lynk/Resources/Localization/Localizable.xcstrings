    "SETTINGS.ALERT.ABOUT.BODY_MESSAGE" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynk ist eine minimalistische, datenschutzorientierte App, mit der du Texte und URLs einfach speichern und teilen kannst. Egal, ob du Notizen sammelst, wichtige Links speicherst oder schnell etwas mit Freunden teilst – wir speichern alles in deiner iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynk is a minimal, privacy-focused app that makes it easy to save and share text and URLs. Whether you're collecting notes, saving important links, or quickly sharing something with a friend, we keep everything in your iCloud"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynk es una app minimalista y centrada en la privacidad que facilita guardar y compartir texto y URL. Ya sea que estés recopilando notas, guardando enlaces importantes o compartiendo algo rápidamente con un amigo, lo guardamos todo en tu iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lynk est une application minimaliste axée sur la confidentialité qui simplifie l'enregistrement et le partage de textes et d'URL. Que vous preniez des notes, sauvegardiez des liens importants ou partagiez rapidement un contenu avec un ami, tout est conservé dans votre iCloud."
          }
        }
      }
    },
    "SETTINGS.ALERT.ABOUT.BUTTON.VIEW_ON_GITHUB" : {
